# Endless Labyrinth - what Git never uploads to GitHub.

# The developer's private tools, including the Event Maker.
Developer Tools/

# Old versions of the game, and files waiting to be deleted (in any folder).
Dev Builds/Backups/
_to_delete/

# Python's own scratch files.
__pycache__/
*.pyc

# Half-finished downloads and saves, and save files the game refused.
*.part
*.rejected-*

# Player save data. Scores and settings are saved on each player's own computer
# only, so none of them are ever uploaded. (players/README.md is kept, so the
# folder itself is still part of the game.)
players/*
!players/README.md
Dev Builds/highscores.json
Dev Builds/highscores.json.imported
Dev Builds/settings.json

# The built program (Developer Tools/Build Game.bat makes it). Shared as a zip,
# never committed.
Build/

# A backup of the developer's event signing key: never uploaded, wherever it is saved.
*.elkey

# What a player's game notes about sounds it downloaded (made on players' computers only).
Dev Builds/sounds/sounds_fetched.json

# The game's code, design notes and libraries stay on the developer's computer.
# GitHub holds only what players' games read from it: the sounds, the events and the
# public event key.
Dev Builds/*
!Dev Builds/sounds/
!Dev Builds/event_key.pub
