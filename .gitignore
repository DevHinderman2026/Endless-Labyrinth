# Endless Labyrinth - what Git never uploads to GitHub.

# The developer's private tools, including the Event Maker.
Developer Tools/

# Old versions of the game, and files waiting to be deleted (in any folder).
Dev Builds/Backups/
_to_delete/

# Python's own scratch files.
__pycache__/
*.pyc

# Half-finished downloads and saves, and save files the game refused.
*.part
*.rejected-*

# Player save data. Scores and settings are saved on each player's own computer
# only, so none of them are ever uploaded. The game makes the players folder itself,
# and the release zip includes it with its README.
players/
Dev Builds/highscores.json
Dev Builds/highscores.json.imported
Dev Builds/settings.json

# The built program (Developer Tools/Build Game.bat makes it). Shared as a zip,
# never committed.
Build/

# A backup of the developer's event signing key: never uploaded, wherever it is saved.
*.elkey

# The game's code, design notes, libraries and sounds stay on the developer's computer.
# GitHub holds only what players' games read from it (the events and the public event
# key) and the sound credits. The sounds reach players only inside the game: Pixabay's
# license does not allow handing them out on their own, so they are never uploaded,
# and neither are the untouched downloads they were edited from (sounds/originals).
Dev Builds/*
!Dev Builds/sounds/
Dev Builds/sounds/*
!Dev Builds/sounds/CREDITS.md
!Dev Builds/event_key.pub
